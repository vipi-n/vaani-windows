<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Vaani</AssemblyName>
    <RootNamespace>Vaani</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <!-- Native whisper libs must be extracted when publishing single-file -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Whisper.net" Version="1.5.0" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.5.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <!-- Using both WPF + WinForms makes several type names ambiguous
       (Application, Rectangle, Color, Point, Clipboard, ...). We drop the
       auto-imported WinForms/Drawing global usings; the code fully-qualifies
       those types explicitly (WinForms.* alias and System.Drawing.*). -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- The Whisper model is downloaded during CI and placed in models/.
       It is copied next to the executable so the app is fully offline. -->
  <ItemGroup>
    <None Include="models\ggml-small.bin" Condition="Exists('models\ggml-small.bin')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>ggml-small.bin</Link>
    </None>
  </ItemGroup>

</Project>
